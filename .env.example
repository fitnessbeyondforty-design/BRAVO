# ── Supabase (project settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (project settings → database → connection string, "Session" pooler) ──
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Upstash Redis (rate limiting) — optional; app runs without it ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments (fill when wiring the review-fee flow) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
